# Application
APP_NAME=AI-Powered ERP Assistant
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=true

# MySQL Database
MYSQL_DATABASE=erp_assistant
MYSQL_USER=erp_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_root_password

# Local development database connection
DATABASE_URL=mysql+pymysql://erp_user:change_this_password@localhost:3306/erp_assistant

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Separate read-only database account for AI analytics
AI_DATABASE_URL=mysql+pymysql://erp_ai_readonly:change_ai_readonly_password@localhost:3306/erp_assistant

# Spring Boot ERP Integration
SPRING_BOOT_ERP_BASE_URL=http://spring-boot-erp:8080
SPRING_BOOT_INTERNAL_TOKEN=replace_with_a_long_random_secret
