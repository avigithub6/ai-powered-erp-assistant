# Application
APP_NAME=AI-Powered ERP Assistant
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=true

# MySQL Database
MYSQL_DATABASE=erp_assistant
MYSQL_USER=erp_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_root_password

# Local development database connection
DATABASE_URL=mysql+pymysql://erp_user:change_this_password@localhost:3306/erp_assistant

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
